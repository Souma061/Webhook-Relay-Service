RELAY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/webhook_relay
RELAY_REDIS_URL=redis://localhost:6379/0
RELAY_DEBUG=true
RELAY_RATE_LIMIT_RPM=60
RELAY_MAX_DELIVERY_ATTEMPTS=5
RELAY_RETRY_BACKOFF_MS=1000
RELAY_DELIVERY_TIMEOUT_MS=10000
RELAY_CIRCUIT_BREAKER_THRESHOLD=10
RELAY_CIRCUIT_BREAKER_COOLDOWN_S=30
RELAY_IDEMPOTENCY_TTL_S=86400
"""
.env.example — Environment variable template.

All config is driven by env vars prefixed with RELAY_.
Copy this file to .env and adjust values for your environment.
"""
