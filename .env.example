# When running via docker compose use service names (postgres, redis, kafka)
# When running locally without Docker change these to localhost
RELAY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/webhook_relay
RELAY_REDIS_URL=redis://redis:6379/0
RELAY_ENVIRONMENT=development
RELAY_DEBUG=true
RELAY_CORS_ALLOWED_ORIGINS=http://localhost:5173
RELAY_RATE_LIMIT_RPM=60
RELAY_MAX_DELIVERY_ATTEMPTS=5
RELAY_RETRY_BACKOFF_MS=1000
RELAY_DELIVERY_TIMEOUT_MS=10000
RELAY_CIRCUIT_BREAKER_THRESHOLD=10
RELAY_CIRCUIT_BREAKER_COOLDOWN_S=30
RELAY_IDEMPOTENCY_TTL_S=86400
RELAY_MAX_WEBHOOK_BODY_BYTES=1048576
RELAY_ALLOW_INSECURE_DELIVERY_URLS=false
RELAY_AUTH_RATE_LIMIT_PER_MINUTE=10

# ── Kafka (Phase 2) ────────────────────────────────────────────────────────────
# When running via docker-compose, use: kafka:9092
# When running locally, use: localhost:9092
RELAY_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
RELAY_KAFKA_TOPIC_RAW_EVENTS=raw-events
RELAY_KAFKA_TOPIC_TRANSFORMED_EVENTS=transformed-events
RELAY_KAFKA_TOPIC_DEAD_LETTER=dead-letter
RELAY_KAFKA_CONSUMER_GROUP_TRANSFORM=relay-transform-group
RELAY_KAFKA_CONSUMER_GROUP_DELIVERY=relay-delivery-group

# ── Auth / JWT ─────────────────────────────────────────────────────────────────
# Change this to a long random string in production!
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
RELAY_JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
RELAY_JWT_ALGORITHM=HS256
RELAY_JWT_EXPIRE_MINUTES=1440
RELAY_PASSWORD_PEPPER=change-me-in-production-use-a-second-long-random-string
